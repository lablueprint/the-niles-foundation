{
    "name": "the-niles-foundation",
    "private": true,
    "workspaces": [
        "apps/*",
        "package/*"
    ],
    "scripts": {
        "db:start": "supabase start",
        "db:stop": "supabase stop",
        "db:status": "supabase status",
        "db:reset": "supabase db reset",
        "db:link": "supabase link",
        "db:new": "supabase migration new",
        "db:migrate": "supabase migration up",
        "db:studio": "echo 'Supabase Studio: http://localhost:54323' && (open http://localhost:54323 2>/dev/null || echo 'Please open the URL above in your browser')",
        "gen:types": "supabase gen types typescript --local > packages/db-types/database.types.ts",
        "mobile": "npm run start -w apps/mobile",
        "dashboard": "npm run dev -w apps/dashboard"
    },
    "overrides": {
        "react": "19.3.0",
        "react-dom": "19.3.0"
    },
    "devDependencies": {
        "supabase": "^2.122.0"
    }
}
